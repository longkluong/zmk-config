#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC         &kp N1    &kp N2    &kp N3  &kp N4  &kp N5  &kp N6     &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS  &kp EQUAL  &kp BSPC   &bt BT_CLR_ALL
&kp TAB         &kp Q     &kp W     &kp E   &kp R   &kp T   &kp Y      &kp U   &kp I      &kp O    &kp P     &kp LBKT   &kp RBKT   &kp BSLH
&lt 1 CAPSLOCK  &kp A     &kp S     &kp D   &kp F   &kp G   &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp SQT               &kp RET
&kp LSHFT       &kp Z     &kp X     &kp C   &kp V   &kp B   &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH                        &kp RSHFT
&kp LCTRL       &kp LALT  &kp LGUI                          &kp SPACE                              &kp RGUI  &mo 2      &mo 1      &trans
            >;
        };

        raise {
            bindings = <
&kp GRAVE  &kp F1            &kp F2        &kp F3             &kp F4  &kp F5  &kp F6  &kp F7      &kp F8    &kp F9     &kp F10  &kp F11  &kp F12  &kp DEL  &trans
&trans     &trans            &kp LC(UP)    &trans             &trans  &trans  &trans  &kp N8      &kp UP    &trans     &trans   &trans   &trans   &trans
&trans     &kp LA(LC(LEFT))  &kp LC(DOWN)  &kp LC(LA(RIGHT))  &trans  &trans  &trans  &kp LEFT    &kp DOWN  &kp RIGHT  &trans   &trans            &trans
&trans     &trans            &trans        &trans             &trans  &trans  &trans  &kp C_MUTE  &trans    &trans     &trans                     &trans
&trans     &trans            &trans                                           &trans                                   &trans   &trans   &trans   &trans
            >;
        };

        setting {
            bindings = <
&kp LS(TILDE)  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &kp C_VOL_DN  &kp C_VOLUME_UP  &trans       &trans
&trans         &trans                &trans                &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans        &trans           &sys_reset
&trans         &trans                &trans                &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans                         &bootloader
&trans         &trans                &trans                &trans  &trans  &trans  &trans  &kp C_MUTE  &trans  &trans  &trans                                 &trans
&bt BT_PRV     &bt BT_NXT            &bt BT_CLR_ALL                                &trans                              &trans  &trans        &trans           &trans
            >;
        };
    };
};
